@page
@model RPtest.Pages.ListeVillesModel
@{
	Layout = "Dashboard";
    ViewData["Title"] = "Liste de Villes";
}

    <p>
        <a asp-page="/AddVille" class="btn btn-primary"> + Ajouter une ville</a>
    </p>

    <table class="table">
        <thead>
            <tr>
                <th>Villes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ville in Model.Villes)
            {
                <tr>
                    <td>@ville.Nom</td>
                    <td>
                        <a asp-page="EditVille" asp-route-id="@ville.Id" class="btn btn-warning">Modifier</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@ville.Id" style="display:inline;">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
