@page
@model RPtest.Pages.ListNotificationModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Types de dépenses";
}
@section Head {
    <style>
        .b{
            margin:1px;
            width:100px;
        }
        td, th {
            vertical-align: middle;
        }
        .form-group {
            margin-bottom: 10px;
        }
    </style>
}

<p>
    <a asp-page="AddNotification" class="btn btn-primary">+ Ajouter un type de dépense</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Titre</th>
            <th><nobr>Période</nobr></th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Visites Techniques</td>
            <td>0 jours<br />6 mois<br /> 0 années</td>
            <td>Pour vehicules de location : Dans 1 année la premiere foi, et 6 mois après.</td>
            <td>
                <a class="btn btn-secondary b" disabled>Modifier</a><br />
                <a class="btn btn-secondary b" disabled>Supprimer</a>
            </td>
        </tr>

        <tr>
            <td>Vidanges</td>
            <td>0 jours<br/>0 mois<br/> 1 années</td>
            <td>Après 1 année, ou, après le kilométrage entre 2 vidanges est dépassé.</td>
            <td>
                <a class="btn btn-secondary b" disabled>Modifier</a><br />
                <a class="btn btn-secondary b" disabled>Supprimer</a>
            </td>
        </tr>

        @foreach (var notification in Model.Notifications)
        {
            <tr>
                <td>@notification.Titre</td>
                <td>@(notification.Jours ?? 0) jours<br /> @(notification.Mois ?? 0) mois<br /> @(notification.Annees ?? 0) années</td>
                <td>@notification.Description</td>
                <td>
                    <a asp-page="AddNotification" asp-route-id="@notification.Id" class="btn btn-warning b">Modifier</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@notification.Id">
                        <button type="submit" class="btn btn-danger b" onclick="return confirm('Supprimer ?');">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>