@page
@using System
@model ListLocationsModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Locations";
}

@section Head {
    <style>
        td{
            vertical-align:middle;
        }
        .photo{
            width:100px;
        }
        .button{
            font-size: 0.8rem;
            width: 50px;
            margin:1px;
        }
    </style>
}


    <table class="table table-bordered table-striped">
        <thead>
            <tr style="text-align:center;">
                <th>N°</th>
                <th>Date</th>
                <th style="max-width:150px;">Nom client</th>
                <th>Téléphone</th>
                <th>Véhicule</th>
                <th><nobr>Lieu de Départ</nobr></th>
                <th><nobr>Lieu de Retour</nobr></th>
                <th><nobr>Revenus<span style="font-size:0.6rem;"> (DH)</span></nobr></th>
                <th>Statut</th>
                <th style="width:55px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Locations)
            {
                <tr>
                    <td>#@l.Id.ToString("D6")</td>
                    <td>@l.Date.ToString("dd/MM/yyyy")</td>
                    <td style="max-width:150px;">@l.NomClient</td>
                    <td>@l.Tel</td>
                    <td style="text-align:center;">
                        <img src="images/@l?.Vehicule?.Photo" alt="@l?.Vehicule?.Model.Nom" class="photo" /><br />
                        @l.Vehicule?.Immatriculation
                    </td>
                    <td>@l.LieuDepart</td>
                    <td>@l.LieuRetour</td>
                    <td>@(l?.Paiements.Sum(p=>p.Montant) ?? 0)</td>
                    <td>
                        @switch (l.Statut)
                        {
                            case "Complet":
                                <span class="badge bg-success">Complet</span>
                                break;
                            case "Annulé":
                                <span class="badge bg-danger">Annulé</span>
                                break;
                            default:
                                <span class="badge bg-warning text-dark">En cours</span>
                                break;
                        }
                    </td>
                    <td style="text-align:center; width:55px;">
                        <a asp-page="DetailsLocation" asp-route-id="@l.Id" class="btn btn-primary button"><i class="fa fa-eye" aria-hidden="true"></i></a>
                        <a asp-page="EditLocations" asp-route-id="@l.Id" asp-route-vehiculeId="@l.VehiculeId" class="btn btn-warning button"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@l.Id" style="display:inline;">
                            <button type="submit" class="btn btn-danger button" onclick="return confirm('Supprimer ?');">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
