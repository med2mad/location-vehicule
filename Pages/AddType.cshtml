@page
@model RPtest.Pages.AddTypeModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = Model.Type.Id == 0 ? "Ajouter un type" : "Modifier le type";
}

<form method="post">
    <input type="hidden" asp-for="Type.Id" />

    <div class="form-group">
        <label asp-for="Type.Nom" class="control-label">Type</label>
        <input asp-for="Type.Nom" class="form-control" required />
        <span asp-validation-for="Type.Nom" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Enregistrer" class="btn btn-success" />
        <a asp-page="ListType" class="btn btn-secondary">Annuler</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}