@page
@model RPtest.Pages.FactureModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Facture";
}

@section Head {
    <style>
        .card {
            margin: 20px;
        }

        .card-title {
            padding: 10px;
            margin-bottom: 20px;
            border-bottom: solid 1px #d2d2d2;
            font-size: 1.6rem;
        }

        .dotted-line {
            display: flex;
            white-space: nowrap;
        }

        .leader{
            font-weight: bold;
            margin-right:5px;
        }

        .dotted{
            border-bottom: 1px dotted #000;
            width: 100%;
            position: relative;
            top: -0.5em;
            margin-left: 2px;
        }
    </style>
}

<div id="ddd" style="padding: 0; margin: 0;">

    <div class="card">
        <h5 class="card-title">Client</h5>
        <div style="margin-left:10px;">
            <div class="dotted-line">
                <div class="leader">Nom : </div>
                <div>@Model.Location.NomClient</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Téléphone : </div>
                <div>@Model.Location.Tel</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Email : </div>
                <div>@Model.Location.Paiements.FirstOrDefault().Email</div>
                <div class="dotted"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h5 class="card-title">Réservation</h5>
        <div style="margin-left:10px;">
            <div class="dotted-line">
                <div class="leader">N° : </div>
                <div>#@Model.Location.Id.ToString("D6")</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Date : </div>
                <div>@Model.Location.Date.ToString("dd/MM/yyyy")</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Lieu de Départ : </div>
                <div>@Model.Location.LieuDepart</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Lieu de Retour : </div>
                <div>@Model.Location.LieuRetour</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Date de Départ : </div>
                <div>@Model.Location.DateDepart.ToString("dd/MM/yyyy")</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Date de Retour : </div>
                <div>@Model.Location.DateRetour.ToString("dd/MM/yyyy")</div>
                <div class="dotted"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h5 class="card-title">Paiement</h5>
        <div style="margin-left:10px;">
            <div class="dotted-line">
                <div class="leader">Montant : </div>
                <div>@Model.Location.Paiements.FirstOrDefault().Montant DH</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Rib : </div>
                <div>@Model.Location.Paiements.FirstOrDefault().Rib</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">date d'expiration de la carte bancaire : </div>
                <div>@Model.Location.Paiements.FirstOrDefault().Expiration</div>
                <div class="dotted"></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h5 class="card-title">Véhicule</h5>
        <div style="margin-left:10px;">
            <div class="dotted-line">
                <div class="leader">Immatriculation : </div>
                <div>@Model.Location.Vehicule.Immatriculation</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Type de véhicule : </div>
                <div>@Model.Location.Vehicule.Model.Type</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Modèle : </div>
                <div>@Model.Location.Vehicule.Model.Marque @Model.Location.Vehicule.Model.Nom</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Kilométrage dernier : </div>
                <div>@Model.Location.Vehicule.KilometrageActuel</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Climatisation : </div>
                <div>@Model.Location.Vehicule.Climatisation</div>
                <div class="dotted"></div>
            </div>
            <div class="dotted-line">
                <div class="leader">Boîte de vitesses : </div>
                <div>@Model.Location.Vehicule.Boite</div>
                <div class="dotted"></div>
            </div>
        </div>
    </div>

</div>

<a onclick="dddf()" class="btn btn-danger"><i class="fa-solid fa-file-pdf"></i> Telecharger en PDF</a>
<a asp-page="DetailsLocation" asp-route-id="@Model.Location.Id" class="btn btn-secondary">Retour</a>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        function dddf(){
        const element = document.getElementById('ddd');
          const opt = {
            margin: [10, 10, 10, 10], // [top, right, bottom, left] in mm
            filename: 'document.pdf',
            html2canvas: {
              scale: 2,
              scrollY: 0, // Important for positioning
              windowHeight: element.scrollHeight
            },
            jsPDF: {
              unit: 'mm',
              format: 'a4',
              orientation: 'portrait'
            }
          };

          html2pdf().set(opt).from(element).save();
        }
    </script>
}
