@page
@model RPtest.Pages.factureModel
@{
}

<div id="ddd" class="d-none">
    <div class="row justify-content-center">
        <div class="col-md-5 card">
            <h5 class="card-title">Client</h5>
            <dl class="row" style="margin-left:10px;">
                <dt class="col-sm-3">Nom</dt>
                <dd class="col-sm-9">@Model.Location.NomClient</dd>
                <dt class="col-sm-3">Téléphone</dt>
                <dd class="col-sm-9">@Model.Location.Tel</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Location.Paiements.FirstOrDefault().Email</dd>
            </dl>
        </div>
        <div class="col-md-5 card">
            <h5 class="card-title">Réservation</h5>
            <dl class="row" style="margin-left:10px;">
                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.Location.Date.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Statut</dt>
                <dd class="col-sm-8">@Model.Location.Statut</dd>
                <dt class="col-sm-4">Lieu de Départ</dt>
                <dd class="col-sm-8">@Model.Location.LieuDepart</dd>
                <dt class="col-sm-4">Lieu de Retour</dt>
                <dd class="col-sm-8">@Model.Location.LieuRetour</dd>
                <dt class="col-sm-4">Date de Départ</dt>
                <dd class="col-sm-8">@Model.Location.DateDepart.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Date de Retour</dt>
                <dd class="col-sm-8">@Model.Location.DateRetour.ToString("dd/MM/yyyy")</dd>
            </dl>
        </div>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-5 card">
            <h5 class="card-title">Paiement</h5>
            <dl class="row" style="margin-left:10px;">
                <dt class="col-sm-4">Montant</dt>
                <dd class="col-sm-8">@Model.Location.Paiements.FirstOrDefault().Montant DH</dd>
                @* <dt class="col-sm-4">Date</dt>  <dd class="col-sm-8">@Model.Location.Paiements.FirstOrDefault().Date.ToString("dd/MM/yyyy")</dd> *@
                <dt class="col-sm-4">Rib</dt>
                <dd class="col-sm-8">@Model.Location.Paiements.FirstOrDefault().Rib</dd>
                <dt class="col-sm-9">date d'expiration de la carte bancaire</dt>
                <dd class="col-sm-3">@Model.Location.Paiements.FirstOrDefault().Expiration</dd>
            </dl>
        </div>
        <div class="col-md-5 card">
            <h5 class="card-title">Véhicule</h5>
            <dl class="row" style="margin-left:10px;">
                <dt class="col-sm-5">Immatriculation</dt>
                <dd class="col-sm-7">@Model.Location.Vehicule.Immatriculation</dd>
                <dt class="col-sm-5">Type de véhicule</dt>
                <dd class="col-sm-7">@Model.Location.Vehicule.Model.Type</dd>
                <dt class="col-sm-5">Modèle</dt>
                <dd class="col-sm-7">@Model.Location.Vehicule.Model.Marque @Model.Location.Vehicule.Model.Nom</dd>
                <dt class="col-sm-5">Kilométrage dernier</dt>
                <dd class="col-sm-7">@Model.Location.Vehicule.KilometrageActuel</dd>
                <dt class="col-sm-5">Climatisation</dt>
                <dd class="col-sm-7">@Model.Location.Vehicule.Climatisation</dd>
            </dl>
        </div>
    </div>
</div>

<a onclick="dddf()" class="btn btn-danger">Facture en PDF</a>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        function dddf(){
                            var element = document.getElementById('ddd');
                html2pdf(element);
        }

    </script>
}