@page
@model RPtest.Pages.RevenusModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Revenu par Véhicule";
}
@section Head {
    <style>
        td, th {
            vertical-align: middle;
            text-align:center;
        }
        .photo {
            width: 150px;
        }
        .search-bar {
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        .search-bar select, .search-bar input {
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.8rem !important;
        }
        .searchcontainer {
            border: solid 1px #b8c4d1;
            border-radius: 20px;
            background-color: #f2f2f2;
        }
        .submit {
            padding: 10px;
            width: 50px;
            margin-top: 1px;
        }
        label {
            font-size: 0.9rem;
            margin-bottom: 0;
        }
    </style>
}

<div class="row align-items-center mb-3" style="justify-content: center">

    <div class="col-lg-10 searchcontainer">

        <form method="get" class="trip-form mb-2 mt-2 search-bar">
            <div class="row" style="align-items:center; justify-content:space-around !important;">
                <div class="mb-md-0 col-md-1 d-md-block d-flex align-items-center">
                    <label asp-for="Location.DateDepart" class="form-label mr-3"><nobr>Période : </nobr></label>
                </div>

                <div class="mb-md-0 col-md-1 d-md-block d-flex align-items-center">
                    <label asp-for="Location.DateDepart" class="form-label mr-3"><nobr>de</nobr></label>
                </div>
                <div class="mb-md-0 col-md-2 d-md-block d-flex align-items-center">
                    <input asp-for="Location.DateDepart" name="Location.DateDepart" type="date" style="height:35px; padding:5px;" class="form-control" required>
                </div>

                <div class="mb-md-0 col-md-1 d-md-block d-flex align-items-center">
                    <label asp-for="Location.DateDepart" class="form-label mr-3"><nobr>à</nobr></label>
                </div>
                <div class="mb-md-0 col-md-2 d-md-block d-flex align-items-center">
                    <input asp-for="Location.DateRetour" name="Location.dateRetour" type="date" style="height:35px; padding:5px;" class="form-control" required>
                </div>

                <div class="mb-3 mb-md-0 col-md-2" style="text-align:center;padding:0 !important;">
                    <button type="submit" class="btn btn-primary submit"><i class="fa fa-search" aria-hidden="true"></i></button>
                    <a asp-page-handler="CarsList" class="btn btn-secondary submit"><i class="fa fa-times" aria-hidden="true"></i></a>
                </div>
            </div>
        </form>

    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Modèle</th>
            <th>Immatriculation</th>
            <th><nobr>Prix <span style="font-size:0.6rem;">(DH)</span></nobr></th>
            <th>Nombre de Locations</th>
            <th><nobr>Revenus Total <span style="font-size:0.6rem;">(DH)</span></nobr></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model.VehiculesAvecRevenu)
        {
            <tr>
                <td><img src="/images/@v.Photo" class="photo" alt="@v.Photo"></td>
                <td>@v.Model</td>
                <td>@v.Immatriculation</td>
                <td>@v.Prix</td>
                <td>@v.NombreLocations</td>
                <td>@v.RevenuTotal</td>
            </tr>
        }
    </tbody>
</table>