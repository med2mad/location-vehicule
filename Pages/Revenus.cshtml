@page
@model RPtest.Pages.RevenusModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Revenu par Véhicule";
}
@section Head {
    <style>
        .main-content {
            padding-top: 10px;
        }
        td, th {
            vertical-align: middle;
            text-align:center;
        }
        .photo {
            width: 150px;
        }
        .search-bar {
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        .search-bar select, .search-bar input {
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.8rem !important;
            height:35px;
        }
        .searchcontainer {
            border: solid 1px #b8c4d1;
            border-radius: 20px;
            background-color: #f2f2f2;
        }
        .submit {
            padding: 10px;
            width: 50px;
            margin-top: 1px;
        }
        label {
            font-size: 0.9rem;
            margin-bottom: 0;
        }
    </style>
}

<div class="row align-items-center mb-3" style="justify-content: center">

    <div class="col-lg-10 searchcontainer">

        <form method="get" class="trip-form mb-2 mt-2 search-bar">
            <div class="row" style="align-items:center; justify-content:space-around !important;">

                <div class="mb-md-0 col-md-4 d-md-block d-flex align-items-end">
                    <div class="mb-md-0 d-md-block align-items-end">
                        <label><nobr>Période :</nobr></label>
                    </div>
                    <nobr>
                    <input asp-for="StartDate" type="date">
                    <label asp-for="EndDate">à</label>
                    <input asp-for="EndDate" type="date">
                    </nobr>
                </div>

                <div class="mb-md-0 col-md-3 d-md-block d-flex align-items-end">
                    <label asp-for="Immatriculation"><nobr style="font-size: 0.9rem !important;">Immatriculation : </nobr></label>
                    <input asp-for="Immatriculation" class="form-control" style="width:100%;">
                </div>

                <div class="mb-md-0 col-md-3 d-md-block d-flex align-items-end">
                    <nobr>
                        <label asp-for="Sort"><nobr style="font-size: 0.9rem !important;">Trier par : </nobr></label>
                        <select asp-for="Sort" class="custom-select" style="width:100%;">
                            <option value="" selected></option>
                            <option value="Revenu">Revenu</option>
                            <option value="locations">Nombre de locations</option>
                        </select>
                    </nobr>
                </div>

                <div class="mb-3 mb-md-0 col-md-2" style="text-align:center; padding:0 !important;">
                    <button type="submit" class="btn btn-primary submit"><i class="fa fa-search" aria-hidden="true"></i></button>
                    <a asp-page-handler="zzzzzzzzz" class="btn btn-secondary submit"><i class="fa fa-times" aria-hidden="true"></i></a>
                </div>
            </div>
        </form>

    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Photo</th>
            <th>Modèle</th>
            <th><nobr>Prix <span style="font-size:0.6rem;">(DH/Jour)</span></nobr></th>
            <th>Nombre de Locations</th>
            <th><nobr>Revenu Total <span style="font-size:0.6rem;">(DH)</span></nobr></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model.VehiculesAvecRevenu)
        {
            <tr>
                <td><img src="/images/@v.Photo" class="photo" alt="@v.Photo"><br />@v.Immatriculation</td>
                <td>@v.Model</td>
                <td>@v.Prix</td>
                <td>@v.NombreLocations</td>
                <td>@v.RevenuTotal</td>
            </tr>
        }
    </tbody>
</table>