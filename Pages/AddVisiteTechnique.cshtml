@page
@model RPtest.Pages.AddVisiteTechniqueModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = Model.IsNew ? "Ajouter une dépense (Visites Techniques)" : "Modifier une dépense (Visites Techniques)";
    decimal Total = 0;
}

@section Head {
    <style>
        input, select, textarea {
            margin-bottom: 15px;
            border: solid gray 1px !important;
        }
    </style>
}

<h4>Véhicule: @Model.Vehicule.Immatriculation</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="VisiteTechnique.Id" />
            <input type="hidden" asp-for="VisiteTechnique.VehiculeId" />
            <input type="hidden" asp-for="IsNew" />

            <div class="form-group">
                <label asp-for="VisiteTechnique.Montant" class="control-label"></label>
                <input asp-for="VisiteTechnique.Montant" type="number" class="form-control" required />

            </div>

            <div class="form-group">
                <label asp-for="VisiteTechnique.Date" class="control-label"></label>
                <input asp-for="VisiteTechnique.Date" class="form-control" type="date" required />

            </div>

            <div class="form-group">
                <label asp-for="VisiteTechnique.Description" class="control-label"></label>
                <textarea asp-for="VisiteTechnique.Description" class="form-control"></textarea>

            </div>

            <div class="form-group">
                @if (Model.IsNew)
                {
                    <button type="submit" class="btn btn-success">Ajouter</button>
                }
                else
                {
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                }
                <a asp-page="ListVisiteTechnique" asp-route-vehiculeId="@Model.VehiculeId" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>
