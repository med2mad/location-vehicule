@page
@model RPtest.Pages.DepensesNotificationsModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Dépenses";
}
@section Head {
<style>
    td, th {
    vertical-align: middle;
    }
</style>
}
<div style="display:flex; gap:10px;align-items:center;">
    <div style="border-right:solid 1px #c7c8c9; padding-right:10px;">
        <strong>Date véhicule :</strong> @Model.Vehicule.Date.ToString("dd/MM/yyyy") <br />
        <strong>Immatriculation :</strong> @Model.Vehicule.Immatriculation
    </div>
    <div>
        <a asp-page="/CarsList" class="btn btn-secondary">Retour</a>
    </div>
</div>
<hr/>


<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>Temps restant</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            var LastVid = Model.lastVidanges.FirstOrDefault(vdg => vdg.VehiculeId == Model.Vehicule.Id)?.Date ?? Model.Vehicule.Date;
            int? restKilometrage = 0 ;
            if (Model.Vehicule.KilometrageActuel > 0 && Model.Vehicule.KilometrageEntreVidanges > 0) { restKilometrage = Model.Vehicule.KilometrageActuel % Model.Vehicule.KilometrageEntreVidanges; }
            else{ restKilometrage = 1; }
            bool NotifVidange = restKilometrage == 0 || LastVid < DateTime.Now.AddYears(-1);
            var ffvid = DateDifferenceHelper.f(LastVid, 0, 0, 1);
            if (NotifVidange) {
                ffvid.Days = 0;
                ffvid.Months = 0;
                ffvid.Years = 0;
            }

            DateTime? LastVisite = Model.lastVisiteTechniques.FirstOrDefault(vst => vst.VehiculeId == Model.Vehicule.Id)?.Date;
            bool NotifVisite = LastVisite != null ? LastVisite?.AddMonths(6) < DateTime.Now : Model.Vehicule.Date.AddYears(1) < DateTime.Now;
            var ffvis = DateDifferenceHelper.f(DateTime.Today, 0, 0, 0);
            if (NotifVisite) {
                ffvis.Days = 0;
                ffvis.Months = 0;
                ffvis.Years = 0;
            }
            else {
                if (LastVisite != null)
                {
                    ffvis = DateDifferenceHelper.f(LastVid, 0, 6, 0);
                }
                else
                {
                    ffvis = DateDifferenceHelper.f(LastVid, 0, 0, 1);
                }
            }
        }
        <tr class=" @(NotifVisite ? "table-danger" : "")">
            <td> 
                Visites Techniques 
                <span class="ms-2" data-bs-toggle="tooltipVdg" data-bs-html="true" title="Pour vehicules de location : Dans 1 année la premiere foi, et 6 mois après."> 
                    <i class="fa fa-question-circle" aria-hidden="true" style="color:#007bff !important;"></i> 
                </span> 
            </td>
            <td>@(ffvis.Days) jous<br />@(ffvis.Months) mois<br />@ffvis.Years années</td>
            <td> 
                <a asp-page="ListVisiteTechnique" asp-route-vehiculeId="@Model.vehiculeId" class="btn btn-warning">Historique</a> 
            </td> 
        </tr>
        <tr class=" @(NotifVidange ? "table-danger" : "")">
            <td> 
                Vidanges 
                <span class="ms-2" data-bs-toggle="tooltipVdg" data-bs-html="true" title="Après 1 année, ou, après le kilométrage entre 2 vidanges est dépassé."> 
                    <i class="fa fa-question-circle" aria-hidden="true" style="color:#007bff !important;"></i> 
                </span> 
            </td>
            <td>@(ffvid.Days) jous<br />@(ffvid.Months) mois<br />@ffvid.Years années</td>
            <td> 
                <a asp-page="ListVidange" asp-route-vehiculeId="@Model.vehiculeId" class="btn btn-warning">Historique</a> 
            </td>
        </tr> 
        @foreach (var n in Model.Notifications)
        {
            bool NotifDepense = false;
            DateTime LastDepense = Model.lastDepenses.FirstOrDefault(dps => dps.VehiculeId == Model.Vehicule.Id && dps.NotificationId == n.Id)?.Date ?? Model.Vehicule.Date;
            DateTime d = LastDepense.AddDays((double?)n.Jours ?? 0).AddMonths(n.Mois ?? 0).AddYears(n.Annees ?? 0);
            NotifDepense = d < DateTime.Now;
            var ff = DateDifferenceHelper.f(LastDepense,n.Jours ?? 0, n.Mois ?? 0, n.Annees ?? 0);

            <tr class=" @(NotifDepense ? "table-danger" : "")">
                <td>
                    @n.Titre
                    <span class="ms-2" data-bs-toggle="tooltipVdg" data-bs-html="true" title="@n.Description">
                        <i class="fa fa-question-circle" aria-hidden="true" style="color:#007bff !important;"></i>
                    </span>
                </td>
                <td>@(ff.Days) jous<br />@(ff.Months) mois<br />@ff.Years années</td>
                <td>
                    <a asp-page="ListDepense" asp-route-vehiculeId="@Model.vehiculeId" asp-route-notificationId="@n.Id" class="btn btn-warning">Historique</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[data-bs-toggle="tooltipVdg"]').tooltip();
        });
    </script>
}