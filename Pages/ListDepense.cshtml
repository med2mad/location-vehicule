@page
@model RPtest.Pages.ListDepenseModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = @Model.Notification.Titre;
    decimal Total = 0;
}

@section Head {
    <style>
        .button {
            font-size: 0.8rem;
            width: 50px;
            margin: 1px;
        }
        td{
            vertical-align:middle;
        }
        .search-bar {
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        .search-bar select, .search-bar input {
            padding: 5px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 0.8rem !important;
            height:35px;
        }
        .searchcontainer {
            border: solid 1px #b8c4d1;
            border-radius: 20px;
            background-color: #f2f2f2;
        }
        .search-bar .submit {
            padding: 10px;
            width: 50px;
            margin-top: 1px;
        }
        .search-bar label{
            font-size: 0.9rem; 
        }
    </style>
}

<div style="display:flex; gap:10px;align-items:center;">
    <div style="border-right:solid 1px #c7c8c9; padding-right:10px;">
        <strong>Immatriculation :</strong> @Model.VehiculeImmatriculation <br />
        <strong>Date véhicule :</strong> @Model.VehiculeDate
    </div>
    <div>
        <a asp-page="DepensesNotifications" asp-route-vehiculeId="@Model.VehiculeId" class="btn btn-secondary"><i class="fa fa-arrow-left"> </i> Retour</a>
    </div>
</div>
<hr />

<div class="row align-items-center mb-3" style="justify-content: center">

    <div class="col-lg-10 searchcontainer">

        <form method="get" class="trip-form mb-2 mt-2 search-bar">
            <input type="hidden" asp-for="VehiculeId" />

            <div class="row" style="align-items:center; justify-content:space-around !important;">

                <div class="mb-md-0 col-md-1 d-md-block d-flex align-items-center text-center">
                    <label><strong><nobr>Période :</nobr></strong></label>
                </div>

                <div class="mb-md-0 col-md-2 d-md-block d-flex align-items-center">
                    <nobr>
                    <label asp-for="StartDate">de</label>
                    <input asp-for="StartDate" type="date">
                    </nobr>
                </div>

                <div class="mb-md-0 col-md-2 d-md-block d-flex align-items-center">
                    <nobr>
                        <label asp-for="EndDate">à</label>
                        <input asp-for="EndDate" type="date">
                    </nobr>
                </div>

                <div class="mb-md-0 col-md-1 d-md-block d-flex align-items-center text-center">
                    |
                </div>

                <div class="mb-md-0 col-md-4 d-md-block d-flex align-items-center">
                    <nobr>
                        <label asp-for="Sort"><strong><nobr style="font-size: 0.9rem !important;">Trier par :</nobr></strong></label>
                        <select asp-for="Sort" class="custom-select" style="width:70%">
                            <option value="" selected></option>
                            <option value="Date">Date</option>
                            <option value="Montant">Montant</option>
                        </select>
                    </nobr>
                </div>

                <div class="mb-3 mb-md-0 col-md-2" style="text-align:center;padding:0 !important;">
                    <button type="submit" class="btn btn-primary submit"><i class="fa fa-search" aria-hidden="true"></i></button>
                    <a asp-page="ListDepense" asp-route-vehiculeId="@Model.VehiculeId" class="btn btn-secondary submit"><i class="fa fa-times" aria-hidden="true"></i></a>
                </div>
            </div>
        </form>

    </div>
</div>

<p>
    <a asp-page="AddDepense" asp-route-vehiculeId="@Model.VehiculeId" asp-route-notificationId="@Model.NotificationId" class="btn btn-primary"> + Ajouter une dépense (@Model.Notification.Titre)</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Montant (DH)</th>
            <th>Date</th>
            <th>Description</th>
            <th style="width:60px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Depenses)
        {
            Total += d.Montant;
            <tr>
                <td>@Html.DisplayFor(modelItem => d.Montant)</td>
                <td>@d.Date.ToString("dd/MM/yyyy")</td>
                <td>@Html.DisplayFor(modelItem => d.Description)</td>
                <td style="width:60px;">
                    <a asp-page="AddDepense" asp-route-id="@d.Id" asp-route-vehiculeId="@Model.VehiculeId" asp-route-notificationId="@Model.NotificationId" class="btn btn-sm btn-warning button"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" asp-route-vehiculeId="@Model.VehiculeId" asp-route-notificationId="@Model.NotificationId" style="display:inline;">
                        <button type="submit" class="btn btn-danger button" onclick="return confirm('Supprimer ?');"><i class="fa fa-times" aria-hidden="true"></i></button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />

<h3>
    Total : @Total DH
</h3>