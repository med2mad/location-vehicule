@page
@model AboutModel
@{
    ViewData["Title"] = "A propos";
}

    <div class="hero inner-page" style="background-image: url('images/header3.png');">

        <div class="container">
            <div class="row align-items-end ">
                <div class="col-lg-5">

                    <div class="intro">
                        <h1><strong>À propos de<br/>nous</strong></h1>
                    </div>

                </div>
            </div>
        </div>
    </div>



    <div class="site-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 mb-5 mb-lg-0 order-lg-2">
                    <img src="images/hero_1.jpg" alt="Image" class="img-fluid rounded">
                </div>
                <div class="col-lg-4 mr-auto">
                    <h2>Société de Location de Voitures</h2>
                    <p>
                        Bienvenue chez nous, votre partenaire de confiance pour la location de véhicules.
                        Depuis la création, nous nous engageons à offrir des solutions flexibles,
                        économiques et adaptées à tous vos besoins, que ce soit pour un déplacement professionnel,
                        des vacances en famille ou une location à long terme.
                    </p>
                    <p>
                        Notre mission <br />
                        Nous croyons que chaque voyage mérite d'être vécu en toute sérénité. C'est pourquoi nous mettons à votre
                        disposition une flotte moderne et diversifiée, soigneusement entretenue pour garantir votre sécurité et votre
                        satisfaction.
                    </p>
                </div>
            </div>
        </div>
    </div>

