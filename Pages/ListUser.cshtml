@page
@model RPtest.Pages.ListUserModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Administrateurs";
}
@section Head {
    <style>
        td {
            vertical-align:middle;
        }
    </style>
}

<a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Url.Page("/ListUser", new { area = "" })" class="btn btn-primary">
    <i class="fa fa-user-plus" aria-hidden="true"></i> Ajouter un administrateur
</a>

<hr />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nom Utilisateur</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.UserName</td>
                <td>
@*                  <a asp-page="./Details" asp-route-id="@user.Id">Details</a>
                    <a asp-page="./Edit" asp-route-id="@user.Id">Edit</a> *@
                    <a asp-page="EditUser" asp-route-id="@user.Id" class="btn btn-warning">Modifier</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" style="display:inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Supprimer ?');">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>