@page
@model RPtest.Pages.ListTypeModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = "Types de véhicule";
}
@section Head {
    <style>
        td {
            vertical-align: middle;
        }
    </style>
}

<p>
    <a asp-page="AddType" class="btn btn-primary"> + Ajouter un nouveau type</a>
</p>

<hr />

<table class="table">
    <thead>
        <tr>
            <th>Types</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Types)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nom)</td>
                <td>
                    <a asp-page="AddType" asp-route-id="@item.Id" class="btn btn-warning">Modifier</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Supprimer ?');">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
