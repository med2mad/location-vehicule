@page
@model RPtest.Pages.AddCouleurModel
@{
    Layout = "Dashboard";
    ViewData["Title"] = Model.Couleur.Id == 0 ? "Ajouter une Couleur" : "Modifier la Couleur";
}

@section Head {
    <style>
        input {
            border: solid gray 1px !important;
        }
    </style>
}

<form method="post">
    <input type="hidden" asp-for="Couleur.Id" />

    <div class="form-group mb-3">
        <label asp-for="Couleur.Nom" class="control-label">Couleur</label>
        <input asp-for="Couleur.Nom" class="form-control" required/>
        <span asp-validation-for="Couleur.Nom" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Enregistrer" class="btn btn-success" />
        <a asp-page="ListType" class="btn btn-secondary">Annuler</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}